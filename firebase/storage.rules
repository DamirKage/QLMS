rules_version = '2';

// Incident photos live at incidents/{uid}/{filename}.jpg — only the owner can
// upload into their own folder; any signed-in user can view (the same trust
// boundary as the public incident feed itself — photos are attached to the
// PUBLIC incident doc, never the private one, so this matches).
service firebase.storage {
  match /b/{bucket}/o {
    match /incidents/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
